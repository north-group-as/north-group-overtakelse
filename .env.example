# Eksempel-miljøvariabler for north-group.
# Kopier til .env.local og fyll inn faktiske verdier (committ aldri .env.local).

# --- Monday.com kontakt-/lead-integrasjon ---
# Server-side kun. ALDRI prefiks med NEXT_PUBLIC_: det ville bake tokenet
# inn i frontend-bundlen og eksponere det for alle besøkende.
# Genereres i monday.com > Profile-meny > Developer > "My access tokens".
MONDAY_API_TOKEN=

# Foretrukket: numerisk board-ID for CRM-tavlen som leads skal lande på.
# Må verifiseres å være riktig board (samme som North Installation-leads,
# typisk 18372254990) før produksjons-aktivering.
MONDAY_BOARD_ID=

# --- Bakoverkompatibel: tidligere navn på samme token ---
# Hvis MONDAY_API_TOKEN ikke er satt, faller koden tilbake til denne.
# Nye deploys bør bruke MONDAY_API_TOKEN.
MONDAY_API_KEY=

# --- Intern e-post-varsling (Resend) ---
# Brukes for å sende kopi av kontaktskjema til post@northgroup.no.
# Hvis ikke satt, fortsetter Monday-integrasjonen som vanlig.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Skjema <noreply@northgroup.no>"

# --- Sikkerhets-logging ---
# Salt for SHA-256-hashing av PII (e-post, telefon, IP) i logger.
# Velg en lang, tilfeldig streng. Endring av denne gjør tidligere
# log-hashes ikke-koblingsbare med nye.
LOG_HASH_SALT=

